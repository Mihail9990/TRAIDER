    <span class="token string">"correlationId"</span><span class="token operator">:</span> <span class="token string">"1"</span><span class="token punctuation">,</span>
    <span class="token string">"payload"</span><span class="token operator">:</span> <span class="token punctuation">{</span>
        <span class="token string">"subscriptions"</span><span class="token operator">:</span> <span class="token punctuation">{</span>
            <span class="token string">"OIL_CRUDE"</span><span class="token operator">:</span> <span class="token string">"PROCESSED"</span>
